#!/usr/bin/env python3
# Copy selected original MarkUI assets verbatim; sources.json records provenance.
from pathlib import Path
import zipfile,shutil,json,hashlib
root=Path('/data/OpenMIUI/马克笔UI/包含扁平图标-WP桌面终极版  工作目录资源包')
out=Path(__file__).resolve().parents[1]/'flutter_shell/assets/wp_icons';(out/'ui').mkdir(exist_ok=True)
zpath=next((root/'WP桌面2c双卡版').glob('*.apk'));z=zipfile.ZipFile(zpath)
manifest={}
def put(dest,source,data):
 p=out/dest;p.write_bytes(data);p.chmod(0o644);manifest[dest]={'source':source,'sha256':hashlib.sha256(data).hexdigest()}
def apk(dest,name):
 source='res/drawable-xxhdpi-v4/'+name+'.png'
 if source not in z.namelist():
  options=[n for n in z.namelist() if n.startswith('res/drawable') and n.endswith('/'+name+'.png')];assert options,name;source=options[-1]
 put('ui/'+dest+'.png',str(zpath.relative_to(root))+':'+source,z.read(source))
ui={'wifi':'ic_toolbox_wifi','wifi_off':'ic_notification_wifi_off','bluetooth':'ic_toolbox_bluetooth','brightness':'ic_toolbox_brightness','volume':'ic_toolbox_ring','mute':'status_mute_w','settings':'ic_toolbox_settings','lock':'ic_toolbox_security','rotate':'ic_toolbox_rotate_screen','airplane':'ic_toolbox_airplane','data':'ic_toolbox_data','hotspot':'ic_toolbox_wifi_hotspot','gps':'ic_toolbox_gps','flashlight':'ic_toolbox_light_on','check':'ic_ok_w','close':'ic_clear','more':'more_btn_w','expand':'ic_expand_more','collapse':'ic_expand_less','chevron':'ic_chevron_right','refresh':'ic_search_refresh','edit':'ic_edit_pen','apps':'ic_cell_app','notifications':'ic_uc_message','file':'ic_trans_file','play':'ic_ringtone_play','theme':'ic_edit_pen','performance':'ic_toolbox_application_manager','delete':'ic_download_delete_w','folder':'ic_home_folder_add','battery':'status_battery_17_w','charging':'status_battery_charging_w','signal':'status_signal_5_w','no_signal':'status_signal_0_w','status_wifi':'status_wifi_4_w','status_bluetooth':'status_bluetooth_w'}
for dest,name in ui.items():apk(dest,name)
for i in range(18):apk('battery_'+str(i),'status_battery_'+str(i)+'_w')
for i in range(6):apk('signal_'+str(i),'status_signal_'+str(i)+'_w')
apps={'browser':'0/edge8 ie.png','files':'0/filemanager8.png','mail':'0/email8.png','phone':'0/phone8.png','contacts':'0/Contacts8.png','messages':'0/message8.png','photos':'0/picture8.png','camera':'0/cam8.png','clock':'0/shizhong8.png','calendar':'0/rili8.png','weather':'0/tianqi8.png','music':'0/music8.png','settings':'0/setting8.png','notes':'0/notes8.png','calculator':'0/jishqi8.png','video':'0/movie8.png','maps':'0/maps8.png','store':'5/Google-Play.png','gimp':'5/GIMP.png','screenshot':'5/Screenshot.png','word':'0/Of_word.png','spreadsheet':'0/Of_excel.png','presentation':'0/Of_powerpoint.png','reader':'4/reader1.png','steam':'5/Steam-alt.png','spotify':'5/Spotify.png','telegram':'5/Messaging.png','blender':'5/Blender.png','vscode':'5/Visual-Studio-2012.png'}
for dest,source in apps.items():
 p=root/'LauncherWP8/icon'/source;put('apps/'+dest+'.png','LauncherWP8/icon/'+source,p.read_bytes())
p=root/'LauncherWP8/icon/0/filemanager8.png'
put('ui/folder.png', 'LauncherWP8/icon/0/filemanager8.png', p.read_bytes())
(out/'sources.json').write_text(json.dumps({'pack':str(root),'apk_sha256':hashlib.sha256(zpath.read_bytes()).hexdigest(),'files':manifest},ensure_ascii=False,indent=2)+'\n')
print('Imported',len(manifest),'original MarkUI assets, without image conversion')

# Optical normalization uses original alpha bounds without changing PNG bytes.
from PIL import Image
lines = ['// Original bitmap alpha bounds; generated by tools/import-markui-icons.',
         'const markUiBounds = <String, List<double>>{']
for path in sorted(out.rglob('*.png')):
 image = Image.open(path).convert('RGBA')
 box = image.getchannel('A').point(lambda a: 255 if a > 16 else 0).getbbox()
 if box:
  values = [float(v) for v in (image.width, image.height, *box)]
  lines.append('  ' + repr(str(path.relative_to(out).with_suffix(''))) + ': ' + str(values) + ',')
lines.append('};')
(out.parents[1]/'lib/src/markui_metrics.dart').write_text('\n'.join(lines)+'\n')
