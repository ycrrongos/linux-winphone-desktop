def run(*args, cwd=ROOT, **kwargs):
    print("+", " ".join(map(str, args)), flush=True)
    return subprocess.run(list(map(str, args)), cwd=cwd, check=True, **kwargs)


def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def source_digest():
    files = [ROOT / "denial/main.dart", ROOT / "denial/desktop_overrides.dart",
        ROOT / "denial/shell_chrome.dart", ROOT / "denial/window_motion_policy.dart",
        ROOT / "denial/preview_capture.dart", ROOT / "denial/client_surface_policy.dart", ROOT / "denial/upstream.lock.json",
        ROOT / "denial/application.pubspec.lock", ROOT / "tools/win10x-denial-native", ROOT / "tools/prepare-denial-native-sysroot", Path(__file__).resolve(),
        SHELL / "pubspec.yaml", SHELL / "pubspec.lock"]
    files.extend(sorted(path for path in (ROOT / "denial/native").rglob("*") if path.is_file()))
    files.extend(sorted((SHELL / "lib").rglob("*.dart")))
    files.extend(sorted((ROOT / "denial/keyboard").rglob("*.dart")))
    files.extend(sorted(path for path in (SHELL / "assets").rglob("*") if path.is_file()))
    value = hashlib.sha256()
    for path in files:
        value.update(str(path.relative_to(ROOT)).encode())
        value.update(path.read_bytes())
    return value.hexdigest()


def download(url, path, checksum):
    if path.exists() and digest(path) == checksum:
        return
    partial = path.with_suffix(path.suffix + ".partial")
    path.parent.mkdir(parents=True, exist_ok=True)
    run("curl", "--fail", "--location", "--show-error", "--retry", "2",
        "--connect-timeout", "15", "--max-time", "600", "--continue-at", "-",
        url, "--output", partial)
    if digest(partial) != checksum:
        partial.unlink()
        raise RuntimeError(f"Checksum mismatch: {url}; removed invalid download")
    partial.replace(path)


def bootstrap():
    if platform.system() != "Linux" or platform.machine() not in ("x86_64", "amd64"):
        raise RuntimeError("This binary kit supports Linux x86_64. ARM64 needs "
            "a matching upstream engine and kit; see docs/denial-migration.md.")
    archives = CACHE / "downloads"
    archives.mkdir(parents=True, exist_ok=True)
    for package in LOCK["packages"]["linux-x64"]:
        archive = archives / package["file"]
        download("https://packages.denialwm.org/arch/x86_64/" + package["file"],
            archive, package["sha256"])
        marker = archives / (package["file"] + ".extracted")
        if not marker.exists():
            # These are checksum-verified official archives, extracted locally.
            run("tar", "-xf", archive, "-C", CACHE)
            marker.write_text(package["sha256"] + "\n")
    sdk = CACHE / "dart-sdk"
    if not (sdk / "bin/dart").exists():
        archive = archives / "dart-sdk.zip"
        download(f"https://storage.googleapis.com/dart-archive/channels/stable/release/{LOCK['dart']}/sdk/dartsdk-linux-x64-release.zip",
            archive, LOCK["dart_sdk_sha256"])
        with zipfile.ZipFile(archive) as source:
            source.extractall(CACHE)
            for member in source.infolist():
                mode = member.external_attr >> 16
                if mode & 0o111:
                    (CACHE / member.filename).chmod(mode & 0o777)
    prepare()


def link(path, target):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        if path.resolve() == target.resolve():
            return
        path.unlink()
    if path.exists():
        raise RuntimeError(f"Refusing to replace existing path: {path}")
    path.symlink_to(target, target_is_directory=target.is_dir())


def replace_once(path, before, after, expected=1):
    text = path.read_text()
    if after in text:
        return
    if text.count(before) != expected:
        raise RuntimeError(f"Upstream patch context changed: {path}")
    path.write_text(text.replace(before, after, 1))


