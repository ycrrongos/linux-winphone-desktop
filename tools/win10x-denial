    loader.exec_module(auth)
    auth.stage(destination, arch)


def native_keyboard_binary(arch):
    loader = importlib.machinery.SourceFileLoader('win10x_native_keyboard', str(ROOT / 'tools/win10x-denial-native'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec); loader.exec_module(module)
    try:
        return module.verified_binary(arch)
    except (FileNotFoundError, RuntimeError) as error:
        raise RuntimeError('Build the matching PC-keyboard native broker first: tools/win10x-denial-native build --target ' + arch) from error


def package():
    output = (WORK / "bundle").resolve()
    provenance = json.loads((output / "win10x-build.json").read_text())
    if provenance.get("source_sha256") != source_digest():
        raise RuntimeError("Rebuild the current worktree before packaging")
    native_binary = native_keyboard_binary("x64")
    destination = ROOT / "packaging/out/denial"
    # Replace only our disposable staging directory, never installed files.
    if destination.exists():
        shutil.rmtree(destination)
    runtime = destination / "lib/win10x-denial/runtime/usr"
    (runtime / "bin").mkdir(parents=True)
    (runtime / "lib/denial").mkdir(parents=True)
    for name in ("deniald", "denialctl", "denial-portal", "denial-polkit-agent", "denial-settings"):
        shutil.copy2(native_binary if name == "deniald" else CACHE / "usr/bin" / name, runtime / "bin" / name, follow_symlinks=False)
    for name in ("settings", "polkit"):
        shutil.copytree(CACHE / "usr/lib/denial" / name, runtime / "lib/denial" / name, symlinks=True)
    for name in ("denial", "denial-flutter-engine"):
        shutil.copytree(CACHE / "usr/share/licenses" / name,
            runtime / "share/licenses" / name)
    shutil.copytree(output, destination / "lib/win10x-denial/shell")
    shutil.copy2(ROOT / "LICENSE", destination / "lib/win10x-denial/LICENSE.win10x")
    shutil.copy2(ROOT / "denial/upstream.lock.json", destination / "lib/win10x-denial/upstream.lock.json")
    (destination / "bin").mkdir()
    (destination / "share/wayland-sessions").mkdir(parents=True)
    shutil.copy2(ROOT / "packaging/win10x-denial-session", destination / "bin/win10x-denial-session")
    shutil.copy2(ROOT / "packaging/win10x-denial-polkit-agent", destination / "bin/win10x-denial-polkit-agent")
    (destination / "libexec").mkdir(exist_ok=True)
    shutil.copy2(ROOT / "packaging/win10x-screen-hooks", destination / "libexec/win10x-screen-hooks")
    shutil.copy2(ROOT / "packaging/win10x-denial.desktop", destination / "share/wayland-sessions/win10x-denial.desktop")
    shutil.copytree(ROOT / "denial/native", destination / "lib/win10x-denial/native-sources")
    shutil.copy2(ROOT / "target/denial-native/x64.json", destination / "lib/win10x-denial/native-build.json")
    stage_auth(destination, "x64")
    print("Staged experimental session:", destination)
    print("Nothing was installed. Review, then run packaging/install-denial-session.sh explicitly.")


def preview(options):
    output = (WORK / "bundle").resolve()
    host = CACHE / "usr/lib/denial/polkit/denial-app"
    if not (output / "lib/libapp.so").exists():
        raise RuntimeError("Build the current worktree first: tools/win10x-denial bundle")
    provenance = json.loads((output / "win10x-build.json").read_text())
    if provenance.get("source_sha256") != source_digest():
        raise RuntimeError("The preview bundle is stale; rebuild with tools/win10x-denial bundle")
    environment = dict(os.environ)
    environment["DENIAL_SHELL_PROFILE"] = "desktop"
    environment["WIN10X_PREVIEW_START"] = "1" if options.start else "0"
    environment["WIN10X_PREVIEW_PANEL"] = options.panel or ""
    if options.capture:
        environment["WIN10X_PREVIEW_CAPTURE"] = str(Path(options.capture).resolve())
    # Preview has its own config, including the optional explicit demo board.
    configuration = WORK / "preview-config"
    environment["XDG_CONFIG_HOME"] = str(configuration)
    environment["XDG_STATE_HOME"] = str(WORK / "preview-state")
    if options.demo:
        config = configuration / "win10x/flutter-shell.json"
        if config.exists() and not options.layout:
            print("Keeping existing isolated preview settings:", config)
        else:
            apps = ["Alacritty", "firefox", "org.kde.dolphin", "cursor",
                "org.kde.konsole", "org.kde.kate", "btop", "org.kde.gwenview"]
            settings = {
                "version": 1, "start_layout_style": options.layout or "windows10",
                "start_tile_animation": "windows10_mobile",
                "app_launch_animation": "windows10_mobile",
                "pinned_apps": apps[:3],
                "groups": [{"id": 1, "title": "常用应用"}, {"id": 2, "title": "工具"}],
                "tiles": [{"app_id": app, "group_id": 1 if i < 4 else 2,
                    "col": (i % 4) * 2, "row": 0, "w": 2, "h": 2}
                    for i, app in enumerate(apps)],
            }
            config.parent.mkdir(parents=True, exist_ok=True)
            config.write_text(json.dumps(settings, ensure_ascii=False, indent=2) + "\n")
    elif options.layout:
        config = configuration / "win10x/flutter-shell.json"
        settings = json.loads(config.read_text()) if config.exists() else {"version": 1}
        settings["start_layout_style"] = options.layout
        config.parent.mkdir(parents=True, exist_ok=True)
        config.write_text(json.dumps(settings, ensure_ascii=False, indent=2) + "\n")
    if options.mode:
        config = configuration / "win10x/flutter-shell.json"
        settings = json.loads(config.read_text()) if config.exists() else {"version": 1}
        settings["shell_mode"] = options.mode
        config.parent.mkdir(parents=True, exist_ok=True)
        config.write_text(json.dumps(settings, ensure_ascii=False, indent=2) + "\n")
    run(host, "--bundle", output, "--engine", output / "lib/libflutter_engine.so",
        "--app-id", "win10x-denial-preview", "--title", "Win10X Denial Preview",
        "--width", options.width, "--height", options.height, env=environment)


def session(options):
    if not options.device:
        raise RuntimeError("Choose the display GPU explicitly: --device /dev/dri/cardN")
    if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
        raise RuntimeError("A graphical session is active. Run preview here; start session only after logging out to a local TTY.")
    device = Path(options.device).resolve()
    if not device.is_char_device():
        raise RuntimeError(f"Not a DRM character device: {device}")
    output = (WORK / "bundle").resolve()
    provenance = json.loads((output / "win10x-build.json").read_text())
    if provenance.get("source_sha256") != source_digest():
        raise RuntimeError("The session bundle is stale; rebuild with tools/win10x-denial bundle")
    environment = dict(os.environ)
    environment.update({
        "DENIAL_SHELL_PROFILE": "desktop", "XDG_SESSION_TYPE": "wayland",
        "XDG_CURRENT_DESKTOP": "Win10X:Denial", "XDG_SESSION_DESKTOP": "Win10X",
        "DENIAL_SETTINGS_BINARY": str(CACHE / "usr/bin/denial-settings"),
        "DENIAL_CONTROL_TOOL": str(CACHE / "usr/bin/denialctl"),
        "DENIAL_COMPOSITOR_BINARY": str(CACHE / "usr/bin/deniald"),
        "PATH": str(CACHE / "usr/bin") + os.pathsep + environment.get("PATH", ""),
    })
    # Native defaults/outputs are configured by Denial; no host display-manager
    # files, user-session targets or unrelated processes are changed here.
    run(CACHE / "usr/bin/deniald", "--device", device, "--wayland",
        "--flutter-bundle", output, "--no-polkit-agent", env=environment)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=[
        "bootstrap", "prepare", "resolve", "analyze", "test", "bundle", "doctor", "preview", "session", "package", "verify"])
    parser.add_argument("--mode", choices=["tablet", "desktop", "phone"], help="select an independent shell mode in isolated preview settings")
    parser.add_argument("--start", action="store_true", help="open Start on preview startup")
    parser.add_argument("--panel", choices=["action-center", "task-view"], help="open a panel on preview startup")
    parser.add_argument("--capture", help="one-shot self-capture of this preview UI after it settles")
    parser.add_argument("--demo", action="store_true", help="seed an isolated preview board")
    parser.add_argument("--layout", choices=["windows10", "windows_phone", "windows8"])
    parser.add_argument("--width", type=int, default=1100)
    parser.add_argument("--height", type=int, default=760)
    parser.add_argument("--device", help="DRM/KMS display device for a manual TTY test session")
    options = parser.parse_args()
    command = options.command
    if command == "test":
        resolve()
        _, dart = tools()
        run(dart, "test", cwd=SHELL)
    elif command == "preview":
        preview(options)
    elif command == "session":
        session(options)
    else:
        globals()[command]()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))

