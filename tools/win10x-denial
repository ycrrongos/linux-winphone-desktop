def publish_bundle(generation, current):
    """Publish by rename, never truncate a library mapped by a live preview."""
    temporary = current.with_name(".bundle-link-" + generation.name)
    temporary.symlink_to(os.path.relpath(generation, current.parent), target_is_directory=True)
    if current.exists() and not current.is_symlink():
        # One-time migration of the older real-directory bundle. Its inodes are
        # retained; future previews resolve the generation before launching.
        legacy = generation.parent / ("legacy-" + generation.name)
        current.rename(legacy)
    os.replace(temporary, current)


def bundle():
    resolve()
    flutter, _ = tools()
    assembly = WORK / "assembly"
    current = WORK / "bundle"
    build_digest = source_digest()
    metadata = current / "win10x-build.json"
    previous = json.loads(metadata.read_text()) if metadata.exists() else {}
    if previous.get("source_sha256") != build_digest:
        # Flutter 3.47.5's release Linux asset target does not declare app.dill
        # as an input. New IconData constants can compile while the old subset
        # font stays cached. Invalidate only that asset target when source changes.
        for stamp in (APP / ".dart_tool/flutter_build").glob("*/release_bundle_linux-x64_assets.stamp"):
            stamp.unlink()
    run(flutter, "assemble", "--suppress-analytics",
        f"--resource-pool-size={max(1, (os.cpu_count() or 1) - 4)}",
        f"--output={assembly}", "-dTargetFile=lib/main.dart", "-dBuildMode=release",
        "-dTargetPlatform=linux-x64", "-dDartObfuscation=false",
        "-dTrackWidgetCreation=false", "-dTreeShakeIcons=true",
        "release_bundle_linux-x64_assets", cwd=APP)
    if source_digest() != build_digest:
        raise RuntimeError("Source changed during compilation; rebuild before previewing or packaging")
    generations = WORK / "bundles"
    generations.mkdir(exist_ok=True)
    output = Path(tempfile.mkdtemp(prefix=build_digest[:12] + "-", dir=generations))
    (output / "lib").mkdir(parents=True, exist_ok=True)
    (output / "data").mkdir(exist_ok=True)
    shutil.copy2(assembly / "lib/libapp.so", output / "lib/libapp.so")
    engine = KIT / "engine/out/denial_host_release"
    shutil.copy2(engine / "libflutter_engine.so", output / "lib/libflutter_engine.so")
    shutil.copy2(engine / "icudtl.dat", output / "data/icudtl.dat")
    assets = output / "data/flutter_assets"
    if assets.exists():
        shutil.rmtree(assets)
    shutil.copytree(assembly / "flutter_assets", assets)
    # Honest custom-bundle provenance; do not claim an official/manager candidate.
    (output / "win10x-build.json").write_text(json.dumps({
        "denial_revision": LOCK["revision"], "release": LOCK["release"],
        "app_sha256": digest(output / "lib/libapp.so"),
        "engine_sha256": digest(output / "lib/libflutter_engine.so"),
        "source_sha256": build_digest,
    }, indent=2) + "\n")
    verify(output)
    publish_bundle(output, current)
    print("Built", current, "->", output)


def font_codepoints(path):
    data = path.read_bytes()
    tables = {}
    for index in range(struct.unpack_from(">H", data, 4)[0]):
        tag, _, offset, _ = struct.unpack_from(">4sIII", data, 12 + index * 16)
        tables[tag] = offset
    cmap = tables[b"cmap"]
    points = set()
    for index in range(struct.unpack_from(">H", data, cmap + 2)[0]):
        _, _, relative = struct.unpack_from(">HHI", data, cmap + 4 + index * 8)
        base = cmap + relative
        kind = struct.unpack_from(">H", data, base)[0]
        if kind == 4:
            count = struct.unpack_from(">H", data, base + 6)[0] // 2
            ends = struct.unpack_from(">" + str(count) + "H", data, base + 14)
            starts = struct.unpack_from(">" + str(count) + "H", data, base + 16 + count * 2)
            for start, end in zip(starts, ends):
                points.update(range(start, end + 1))
        elif kind == 12:
            count = struct.unpack_from(">I", data, base + 12)[0]
            for group in range(count):
                start, end, _ = struct.unpack_from(">III", data, base + 16 + group * 12)
                points.update(range(start, end + 1))
    return points


def verify_shell_assets(bundle):
    count = 0
    for source in (SHELL / "assets").rglob("*.png"):
        target = bundle / "data/flutter_assets/packages/win10x_shell" / source.relative_to(SHELL)
        if not target.is_file() or digest(source) != digest(target):
            raise RuntimeError("Missing/stale shell asset: " + str(source.relative_to(SHELL)))
        count += 1
    print("Verified packaged shell bitmaps:", count)


def verify(bundle_root=None):
    output = Path(bundle_root) if bundle_root else (WORK / "bundle").resolve()
    metadata = json.loads((output / "win10x-build.json").read_text())
    if metadata["source_sha256"] != source_digest():
        raise RuntimeError("Bundle source is stale")
    for name, expected in (("libapp.so", metadata["app_sha256"]),
            ("libflutter_engine.so", metadata["engine_sha256"])):
        if digest(output / "lib" / name) != expected:
            raise RuntimeError("Bundle checksum mismatch: " + name)
    definitions = dict(re.findall(r"static const IconData (\w+)\s*=\s*IconData\(\s*(0x[0-9a-f]+)",
        (KIT / "flutter/packages/flutter/lib/src/material/icons.dart").read_text()))
    used = set()
    for path in (SHELL / "lib").rglob("*.dart"):
        used.update(re.findall(r"\bIcons\.(\w+)", path.read_text()))
    glyphs = font_codepoints(output / "data/flutter_assets/fonts/MaterialIcons-Regular.otf")
    missing = [name for name in sorted(used) if name in definitions and int(definitions[name], 16) not in glyphs]
    if missing:
        raise RuntimeError("Release icon font is stale; missing glyphs: " + ", ".join(missing))
    run(CACHE / "usr/lib/denial/polkit/denial-app", "--bundle", output,
        "--engine", output / "lib/libflutter_engine.so", "--check")
    verify_shell_assets(output)
    print(f"Verified bundle checksums, native ABI and {len(used)} UI icon codepoints")


