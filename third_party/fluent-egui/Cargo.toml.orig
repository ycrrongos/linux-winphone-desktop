[package]
name = "fluent-egui"
version = "0.1.0"
edition = "2024"
description = "Fluent 2 design system implementation for the egui immediate-mode GUI library. "
license = "MIT OR Apache-2.0"
readme = "README.md"
authors = ["Lei tianshuo <leitianshuo1337@gmail.com>", "Qiu Qi <rzsgsfm@gmail.com>"]
repository = "https://github.com/laststudio/fluent-egui"
homepage = "https://fluent-egui.lastudio.cc"
# documentation = "https://docs.rs/fluent-egui"
keywords = ["egui", "fluent2", "gui", "theme", "widgets"]
categories = ["gui", "rendering"]
build = "build.rs"
include = [
    "/src/**",
    "!/src/assets/FluentSystemIcons-Regular.ttf",
    "/examples/**",
    "/tests/**",
    "/docs/**",
    "/Cargo.toml",
    "/build.rs",
    "/README.md",
    "/PROJECT_GUIDE.md",
    "/CHANGELOG.md",
    "/README_zh.md",
    "/PROJECT_GUIDE_zh.md",
    "/CHANGELOG_zh.md",
    "/LICENSE-MIT",
    "/LICENSE-APACHE",
    "/NOTICE",
    "/AUTHORS",
    "/CONTRIBUTING.md",
    "/CONTRIBUTING_zh.md",
]

[[example]]
name = "demo"
path = "examples/demo.rs"
test = true

[[example]]
name = "android"
path = "examples/android.rs"
crate-type = ["cdylib"]
test = false

[features]
default = ["glow", "x11", "wayland", "accesskit"]
accesskit = ["eframe/accesskit"]
glow = ["eframe/glow", "dep:glow", "dep:image"]
wgpu = ["eframe/wgpu_no_default_features", "dep:wgpu", "dep:image"]
x11 = ["eframe/x11", "winit/x11"]
wayland = ["eframe/wayland", "winit/wayland"]
web = [
    "glow",
    "dep:wasm-bindgen",
    "dep:wasm-bindgen-futures",
    "dep:web-sys",
]
android-native-activity = [
    "glow",
    "eframe/android-native-activity",
    "winit/android-native-activity",
]
android-game-activity = [
    "glow",
    "eframe/android-game-activity",
    "winit/android-game-activity",
]
ios = ["wgpu"]
win7 = []
windows-platform = ["dep:windows"]

[dependencies]
eframe = { version = "0.35.0", default-features = false, features = ["default_fonts"] }
glow = { version = "0.17.0", optional = true }
image = { version = "0.25.10", optional = true, default-features = false, features = ["png"] }
raw-window-handle = "0.6.2"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.149"
winit = { version = "0.30.13", default-features = false, features = ["rwh_06"] }
wgpu = { version = "29.0.4", optional = true, default-features = false, features = ["dx12", "metal", "vulkan"] }

[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.61.2", features = ["Win32_Foundation", "Win32_Graphics_Dwm", "Win32_Graphics_Gdi", "Win32_UI_Controls"] }
windows = { version = "0.62.2", optional = true, features = ["Foundation_Metadata", "Media_Capture", "Media_Playback", "Storage_Pickers", "Win32_System_Com", "Win32_System_WinRT", "Win32_UI_Shell"] }

[target.'cfg(target_arch = "wasm32")'.dependencies]
wasm-bindgen = { version = "0.2.114", optional = true }
wasm-bindgen-futures = { version = "0.4.64", optional = true }
web-sys = { version = "0.3.91", optional = true, features = ["HtmlCanvasElement"] }

[profile.release]
lto = "fat"
strip = true
codegen-units = 1
debug = false
opt-level = 3

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
