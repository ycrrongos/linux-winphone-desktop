+#[cfg(all(test, feature = "flutter"))]
+mod win10x_pc_keyboard_tests {
+    use super::shell_named_key_stroke;
+    #[test]
+    fn pc_navigation_function_and_modifier_keys_use_evdev_codes() {
+        for (name, code) in [("Home", 102), ("End", 107), ("F1", 59),
+            ("F10", 68), ("F11", 87), ("F12", 88), ("Shift_L", 42),
+            ("Control_L", 29), ("Alt_L", 56), ("Super_L", 125),
+            ("Page_Up", 104), ("Page_Down", 109), ("KP_Enter", 96)] {
+            let stroke = shell_named_key_stroke(name).expect("supported PC key");
+            assert_eq!(stroke.evdev_keycode, code);
+            assert!(!stroke.shift, "explicit modifier ownership requires unshifted strokes");
+        }
+        assert!(shell_named_key_stroke("Fn").is_none());
+    }
